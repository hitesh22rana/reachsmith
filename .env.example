# Copy to .env and fill in. Never commit real values.
#
# DATABASE_URL is the owner role: it runs migrations (pnpm db:migrate) and
# anything else needing DDL. An owner or superuser bypasses row-level
# security outright, so it must never be the app's connection.
#
# APP_DATABASE_URL is the runtime role the web app and workers use. It must
# be a plain non-superuser role without BYPASSRLS, or tenant RLS is silently
# inert and getDb() refuses to start. The migration creates the
# reachsmith_app role; grant it LOGIN and a password once, out of band:
#   ALTER ROLE reachsmith_app LOGIN PASSWORD '<secret>';
DATABASE_URL="postgresql://reachsmith:reachsmith@localhost:5432/reachsmith"
APP_DATABASE_URL="postgresql://reachsmith_app:reachsmith_app@localhost:5432/reachsmith"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Proxies allowed to set the client IP that keys rate-limit buckets
# (comma-separated IPs or CIDRs). Defaults to loopback + RFC1918 when unset.
# BETTER_AUTH_TRUSTED_PROXIES="10.0.0.0/8"

# Optional private Emailable key. Configuring it enables owner-confirmed checks from the suggestions UI.
# test_ keys simulate results; live_ keys use credits. Never use NEXT_PUBLIC_ here.
EMAILABLE_API_KEY=""
